# =====================================================================
#  reservation-app configuration - TEMPLATE (names only, no values)
#
#  1. Copy this file to ".env" in the same folder:
#        Copy-Item .env.example .env
#  2. Fill in the values. ".env" is git-ignored: never commit it.
#  Real environment variables override the values in .env.
# =====================================================================

# --- MongoDB ---------------------------------------------------------
# Optional. Default: mongodb://localhost:27017/reservation (local MongoDB)
# Atlas example format: mongodb+srv://<user>:<password>@<cluster-host>/<db>?retryWrites=true&w=majority
MONGODB_URI=
# Optional. Default: reservation
MONGODB_DATABASE=

# --- JWT -------------------------------------------------------------
# Required. Base64-encoded random key, at least 256 bits (32 bytes).
# Generate one in PowerShell:
#   $b = New-Object byte[] 64; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET=
# Optional. Token lifetime in milliseconds. Default: 3600000 (1 hour)
JWT_EXPIRATION_MS=

# --- Mail (Gmail SMTP with an App Password) --------------------------
# Optional. If empty, e-mails (activation, password reset...) are disabled.
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Google ----------------------------------------------------------
# Optional. Google API key (currently not used by the code).
GOOGLE_API_KEY=
# Optional. Path to the service-account JSON key, as a Spring resource URL.
# Default: file:./secrets/service-account.json  (the secrets/ folder is git-ignored)
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=

# --- First-start SUPER_ADMIN account ---------------------------------
# Used only when no SUPER_ADMIN exists yet in the database; an existing
# account is never modified. The password is stored as a BCrypt hash.
# The application refuses to start if ADMIN_PASSWORD is weak:
# min. 12 characters and 3 of: lowercase, uppercase, digit, symbol.
# After the first successful start you can remove ADMIN_PASSWORD from .env.
ADMIN_USERNAME=
ADMIN_PASSWORD=
